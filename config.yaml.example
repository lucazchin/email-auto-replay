# ============ 数据库配置 ============
database:
  host: "127.0.0.1"
  port: 3306
  user: "root"
  password: ""                # 通过环境变量 DB_PASSWORD 设置
  database: "email_auto_reply"
  pool_size: 5
  pool_recycle: 3600

# ============ AI 模型配置 ============
ai:
  provider: "deepseek"        # deepseek / openai / qwen / ollama
  api_key: ""                 # 通过环境变量 AI_API_KEY 设置
  base_url: "https://api.deepseek.com/v1"
  model: "deepseek-chat"
  max_tokens: 2000
  temperature: 0.7
  timeout: 30
  retry_times: 3
  retry_interval: 5

# ============ EWS 邮箱配置 ============
ews:
  email: ""                   # 通过环境变量 EWS_EMAIL 设置
  password: ""                # 通过环境变量 EWS_PASSWORD 设置
  server: ""                  # 通过环境变量 EWS_SERVER 设置
  max_emails_per_run: 20

# ============ 定时任务配置 ============
scheduler:
  interval_seconds: 1         # 收件箱检查间隔（秒）
  max_instances: 1
  coalesce: true

# ============ 日志配置 ============
logging:
  level: "INFO"
  dir: "logs"
  rotation: "10 MB"
  retention: "30 days"

# ============ 告警配置 ============
alert:
  enabled: false
  webhook_url: ""
  notify_on:
    - "login_expired"
    - "selector_failed"
    - "send_failed"
    - "ai_error"
